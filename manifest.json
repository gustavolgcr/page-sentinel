{
  "manifest_version": 3,
  "name": "Page Sentinel",
  "version": "1.2.0",
  "description": "Checks websites on a schedule and plays a sound when their content changes.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "notifications",
    "offscreen",
    "idle",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame-reader.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Sentinel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
